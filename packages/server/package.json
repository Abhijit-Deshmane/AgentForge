{
  "name": "@agentforge/server",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "postinstall": "bun run --cwd ../database db:generate"
  },
  "dependencies": {
    "@agentforge/database": "workspace:*",
    "@agentforge/shared": "workspace:*",
    "@ai-sdk/anthropic": "^4.0.49",
    "@ai-sdk/gateway": "^4.0.75",
    "@ai-sdk/openai": "^4.0.60",
    "@hono/zod-validator": "^0.8.0",
    "ai": "^7.0.93",
    "dotenv": "^17.4.2",
    "hono": "4.12.12",
    "zod": "^4.4.3"
  }
}