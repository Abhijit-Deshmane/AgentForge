# ==============================================================================
# AgentForge — Environment Variables Template
# ==============================================================================
# Copy this file to .env and fill in your real credentials:
#   cp .env.example .env
#
# IMPORTANT: Never commit your real .env file or credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database (PostgreSQL via Prisma Pg Adapter)
# ------------------------------------------------------------------------------
# Connection string to your PostgreSQL instance (e.g. Neon, Supabase, local Docker).
# Example: postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agentforge?sslmode=disable"

# ------------------------------------------------------------------------------
# 2. Server & API Configuration
# ------------------------------------------------------------------------------
# URL where the AgentForge Hono backend server is accessible.
# The CLI uses this to communicate with the server and complete OAuth redirects.
API_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 3. AI Model Providers (Vercel AI SDK)
# ------------------------------------------------------------------------------
# Anthropic API Key for Claude Opus 4.6, Claude Sonnet 4.6, and Claude Haiku 4.5
ANTHROPIC_API_KEY="sk-ant-api03-..."

# OpenAI API Key for GPT-5.4, GPT-5.4-mini, and GPT-5.4-nano
OPENAI_API_KEY="sk-proj-..."

# ------------------------------------------------------------------------------
# 4. Authentication (Clerk OAuth & Backend)
# ------------------------------------------------------------------------------
# Clerk OpenID configuration URL or Frontend API domain
CLERK_FRONTEND_API="https://<your-clerk-subdomain>.clerk.accounts.dev/.well-known/openid-configuration"

# Clerk OAuth Application Credentials (configured in Clerk Dashboard -> OAuth Applications)
CLERK_OAUTH_CLIENT_ID="your_clerk_oauth_client_id"
CLERK_OAUTH_CLIENT_SECRET="your_clerk_oauth_client_secret"

# Clerk Instance Keys (configured in Clerk Dashboard -> API Keys)
CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Optional internal JWT secret
JWT_SECRET="your-development-jwt-secret"

# ------------------------------------------------------------------------------
# 5. Billing & Usage Metering (Polar.sh)
# ------------------------------------------------------------------------------
# Polar Personal Access Token for managing checkouts, customer sessions, and events
POLAR_ACCESS_TOKEN="polar_oat_..."

# Target Polar Environment: "sandbox" or "production"
POLAR_SERVER="sandbox"

# Product ID for purchasing AgentForge credits package
POLAR_PRODUCT_ID="00000000-0000-0000-0000-000000000000"

# Meter ID configured in Polar to track agent credit consumption
POLAR_CREDITS_METER_ID="00000000-0000-0000-0000-000000000000"
